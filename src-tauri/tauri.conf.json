{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tongyun-studio",
  "version": "0.1.0",
  "identifier": "com.tongyun.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1438",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "橦云工作台",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; base-uri 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCOTNCQTcwNDIzMjk3MTQKUldRVWx6SkNjTHFUMnkrdmZyVVZ3bHZIa3RyMitoUmNTem0xYXdKdjFCZU1Rb1IxUHBZRTZzYXMK",
      "endpoints": [
        "https://github.com/dangzhuotong/tongyun-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
